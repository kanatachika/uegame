# =============================================================================
# Git Attributes & Git LFS 规则 — 《点数 / DICEBODY》
# =============================================================================
# 1. 统一文本换行符，避免 Windows 与 macOS/Linux 协作时满屏换行符冲突
# 2. 强制 UE5 二进制资产与美术/音频源文件走 Git LFS
# 3. 为无法自动合并的 *.uasset 和 *.umap 开启 lockable 文件锁支持
# =============================================================================

# -------------------------
# 1. 默认与文本文件换行规则
# -------------------------
* text=auto eol=lf

# 代码、着色器、配置与工程描述文件（明确为纯文本，绝不走 LFS）
*.c         text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.hpp       text eol=lf
*.inl       text eol=lf
*.cs        text eol=lf
*.usf       text eol=lf
*.ush       text eol=lf
*.hlsl      text eol=lf
*.ini       text eol=lf
*.uproject  text eol=lf
*.uplugin   text eol=lf

# 文档、配表导出与自动化配置
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.csv       text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf

# Windows 批处理脚本必须保留 CRLF，否则 cmd 执行可能异常
*.bat       text eol=crlf
*.cmd       text eol=crlf

# -------------------------
# 2. UE5 核心资产（LFS + 文件锁）
# -------------------------
# 蓝图、DataTable、材质、动画等资产及关卡地图无法做文本合并，启用 lockable
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uptnl  filter=lfs diff=lfs merge=lfs -text

# -------------------------
# 3. 3D 模型与 DCC 工程文件（LFS）
# -------------------------
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.OBJ    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.abc    filter=lfs diff=lfs merge=lfs -text
*.usdc   filter=lfs diff=lfs merge=lfs -text
*.usdz   filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.ma     filter=lfs diff=lfs merge=lfs -text
*.mb     filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text
*.spp    filter=lfs diff=lfs merge=lfs -text

# -------------------------
# 4. 贴图、UI 图像与原画分层（LFS）
# -------------------------
*.png    filter=lfs diff=lfs merge=lfs -text
*.PNG    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.JPG    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
