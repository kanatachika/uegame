# EditorConfig — 帮助 VS 2022 / Rider / VS Code 自动对齐缩进与编码
# 参考规范：https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# UE5 C++ 源码、C# 构建脚本与 Shader（贴合 Epic 官方 Tab 缩进风格，与 .clang-format 一致）
[*.{c,cpp,h,hpp,inl,cs,usf,ush,hlsl}]
indent_style = tab
indent_size = 4
tab_width = 4

# UE5 配置文件
[*.ini]
indent_style = space
indent_size = 2

# JSON / YAML / GitHub Actions 配置
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown 文档（保留行尾双空格换行语法，不自动裁剪行尾空格）
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Windows 批处理脚本
[*.{bat,cmd}]
end_of_line = crlf
